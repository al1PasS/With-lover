    "motion": "12.23.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "lighthouse": "13.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.2",
    "vite": "7.3.6",
